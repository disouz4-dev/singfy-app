rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuários só acessam o próprio documento (sincronização de setlists)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Uma setlist por documento (formato v2)
    match /users/{uid}/playlists/{playlistId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Sessões colaborativas (Compartilhar): usuário autenticado lê pelo link;
    // só o host cria/altera a sessão; convidado só pode se adicionar (entrar)
    // ou se remover (sair) de participants.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.hostId &&
         request.resource.data.hostId == resource.data.hostId) ||
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['participants', 'updatedAt']) &&
         (request.resource.data.participants.toSet() ==
            resource.data.participants.toSet().union([request.auth.uid].toSet()) ||
          request.resource.data.participants.toSet() ==
            resource.data.participants.toSet().difference([request.auth.uid].toSet())))
      );
      allow delete: if false;
    }

    // Bloqueio geral para qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
